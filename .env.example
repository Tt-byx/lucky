# ============================================================
# 生产环境密码与账号模板
#
# 用法：在服务器上执行 `cp .env.example .env`，然后逐项改成强密码。
# .env 已被 .gitignore 忽略，不会进入 Git 仓库。
# 生成强密码：openssl rand -hex 16
# ============================================================

# MySQL root 密码（backend 用同一密码连接）
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# Redis 访问密码（compose 启动参数与 backend 连接共用）
REDIS_PASSWORD=change-me-to-a-strong-password

# RabbitMQ 专用账号（容器首次初始化时创建；改了这里需要 down -v 重建卷才生效）
RABBITMQ_USERNAME=lucky
RABBITMQ_PASSWORD=change-me-to-a-strong-password

# ============================================================
# 阿里云 OSS 凭据（可选，不配置时上传自动降级为本地存储）
#
# ⚠️ 安全须知：
#   1. 绝不要把真实 AK/SK 写进 .env 后长期留在磁盘上
#   2. 生产环境用部署平台的密钥管理（K8s Secret / 环境变量注入）
#   3. 如果凭据已泄露，立刻去阿里云控制台轮换 AccessKey
#   4. RAM 账号只给 OSS 读写权限，不要用主账号 AK
# ============================================================
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
