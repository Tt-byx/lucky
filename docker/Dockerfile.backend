FROM maven:3.9.6-eclipse-temurin-17-alpine AS builder
WORKDIR /app

# 容器内走阿里云镜像，否则 dependency:go-offline 会从中央仓库拉，构建时间不可控
COPY docker/maven-settings.xml /root/.m2/settings.xml

COPY lucky-server/pom.xml .
RUN mvn dependency:go-offline -B
COPY lucky-server/src ./src
RUN mvn package -DskipTests -B

FROM eclipse-temurin:17-jre-alpine

# 容器默认时区是 UTC，LocalDateTime.now() 会比北京时间晚 8 小时，
# 导致活动开始/结束时间判断、轮次时间窗全部偏移。必须显式设置时区。
RUN apk add --no-cache tzdata
ENV TZ=Asia/Shanghai

WORKDIR /app
COPY --from=builder /app/target/*.jar app.jar

# 注：暂不以非 root 用户运行。named volume（logs-data / uploads-data）挂载后属主是 root，
# 非 root 用户写不进去，除非加 entrypoint 先 chown。对单项目部署系统来说 root 运行可接受，
# 后续要加固时加 entrypoint 脚本或用 initContainer 修权限。
RUN mkdir -p /app/logs /app/uploads

EXPOSE 8080
# 使用生产环境配置
ENTRYPOINT ["java", "-jar", "-Dspring.profiles.active=prod", "-Duser.timezone=Asia/Shanghai", "app.jar"]
