# 生产环境配置（npm run build 时生效）
#
# 容器部署走统一入口 nginx（80 端口），API 与 WebSocket 都指向当前页面所在的主机，
# 因此不要写死任何 IP 或域名——换了部署环境就要重新打包，很容易漏。
#
# VITE_API_BASE 必须为空：代码里拼的是 `${API_BASE}/api/xxx`，填 /api 会变成 /api/api/xxx。
VITE_API_BASE=

# VITE_WS_URL 留空，代码会按 location 自动推导 ws(s)://<当前host>/ws/lucky
VITE_WS_URL=

# ==================== 手机端入口地址（第一层防线） ====================
# 域名备案下来后填在这里，例如：VITE_MOBILE_URL=https://lucky.xxx.cn
# 填了之后大屏二维码完全使用这个地址，不再依赖 hostname 推导；
# 此时即使在 localhost 打开大屏，二维码也是有效的（因为地址来自配置而非推导）。
# 留空时使用「当前页面的协议+主机名」推导，且在 localhost 下会拒绝生成二维码并报警告。
VITE_MOBILE_URL=
